  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:up": "docker start projeto-PTAS1 || docker run -d --name projeto-PTAS1 -p 127.0.0.1:27017:27017 -v projeto-PTAS1-data:/data/db mongo:8",
    "db:down": "docker stop projeto-PTAS1",
    "db:logs": "docker logs -f projeto-PTAS1",
    "db:reset": "docker rm -f projeto-PTAS1; docker volume rm projeto-PTAS1-data",
    "predev": "npm run db:up",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
